class Solution {
public:
    bool isArmstrong(int n) {
        int og=n;
        int len=0;
        while(og!=0){
            len++;
            og=og/10;
        }
        int og2=n;
        int s=0;
        while(og2!=0){
            int d=og2%10;
            s+=pow(d,len);
            og2=og2/10;
        }
        if(s==n){
            return 1;
        }
        return 0;
    }
};
